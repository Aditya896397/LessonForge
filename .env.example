# Required: free key from https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Optional: model names (defaults shown)
# GEMINI_MODEL=gemini-3.5-flash
# GEMINI_QC_MODEL=gemini-3.5-flash
# Tried in order when a model's daily free-tier quota runs out
# GEMINI_FALLBACK_MODELS=gemini-3.5-flash-lite,gemini-3.1-flash-lite

# Research backend: auto (Google Search grounding, falling back to direct web retrieval
# when the key has no grounding quota), gemini (grounding only) or web (retrieval only)
# SEARCH_BACKEND=auto

# Optional: Tavily web search key for the retrieval backend (free tier: https://tavily.com)
# TAVILY_API_KEY=

# Optional: YouTube Data API v3 key (otherwise the public results page is used)
# YOUTUBE_API_KEY=

# Optional: Google Books API key (otherwise anonymous quota, with Open Library as fallback)
# GOOGLE_BOOKS_API_KEY=

# Optional: where lesson projects are saved (default: ./data/lessons)
# LESSONFORGE_DATA_DIR=
